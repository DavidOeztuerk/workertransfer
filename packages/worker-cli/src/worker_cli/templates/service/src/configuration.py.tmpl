"""Service configuration."""

from pydantic import PostgresDsn, RedisDsn
from pydantic_settings import BaseSettings, SettingsConfigDict
from worker_platform.configuration import PlatformSettings, Environment


class ${ServiceClass}Settings(PlatformSettings):
    """Service-specific settings extending platform settings."""
    
    model_config = SettingsConfigDict(
        case_sensitive=False,
        env_file=".env",
        env_file_encoding="utf-8",
        env_prefix="WORKER_",
        extra="ignore",
    )
    
    service_name: str = "${service_name}"
    service_version: str = "0.1.0"
    
    # Database
    database_url: PostgresDsn
    database_pool_size: int = 20
    database_max_overflow: int = 10
    database_echo: bool = False
    
    # Redis
    redis_url: RedisDsn
    
    # RabbitMQ
    rabbitmq_url: str
    
    # JWT
    jwt_secret: str
    jwt_algorithm: str = "RS256"
    access_token_expire_minutes: int = 15
    refresh_token_expire_days: int = 30
    
    # OpenTelemetry
    otel_endpoint: str = "http://jaeger:4317"
    
    # Feature flags
    feature_cqrs: bool = True
    feature_events: bool = True
    feature_messaging: bool = True
    feature_caching: bool = True
    feature_rate_limiting: bool = True
    feature_multitenancy: bool = True
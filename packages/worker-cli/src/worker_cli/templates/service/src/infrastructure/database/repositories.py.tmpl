"""Repository implementations."""

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession
from uuid import UUID
from ${module_name}.domain.entities.example import ExampleEntity
from ${module_name}.domain.repositories.example import ExampleRepository
from ${module_name}.infrastructure.database.models import ExampleModel
from ${module_name}.infrastructure.database.base import TenantAwareRepository

class SqlAlchemyExampleRepository(TenantAwareRepository[ExampleEntity, ExampleModel]):
    def __init__(self, session: AsyncSession):
        super().__init__(session, ExampleModel, ExampleEntityMapper())
    
    async def get_by_email(self, email: str, tenant_id: UUID) -> ExampleEntity | None:
        from ${module_name}.domain.value_objects.example import Email
        stmt = select(ExampleModel).where(
            ExampleModel.tenant_id == tenant_id,
            ExampleModel.email == Email(email).value,
            ExampleModel.is_deleted == False  # noqa: E712
        )
        result = await self._session.execute(stmt)
        model = result.scalar_one_or_none()
        return self._mapper.to_domain(model) if model else None

class ExampleEntityMapper:
    def to_domain(self, model: ExampleModel) -> ExampleEntity:
        return model.to_domain()
    
    def to_model(self, entity: ExampleEntity) -> ExampleModel:
        return ExampleModel.from_domain(entity)
[project]
name = "${package_name}"
version = "0.1.0"
description = "${package_name} WorkerTransfer library"
requires-python = ">=3.14"
dependencies = []

[build-system]
requires = ["uv_build>=0.11,<0.12.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "${module_name}"

[tool.uv.sources]
worker-core = { workspace = true }

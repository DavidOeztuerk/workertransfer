<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    Noelia liegt auf nuget.org. Damit braucht ein Klon dieses Repositorys KEINE
    Anmeldung — weder zum Bauen, noch fuer `docker compose up`, noch in der CI.
    Fuer Girder galt das seit dem 10.09.2026 genauso; der Umstieg auf Noelia
    6.4.0 (ADR-0045) hat daran nichts geaendert.

    DIE ZUORDNUNG BLEIBT, und ihr Grund hat sich nur verschoben. Frueher hielt
    sie ein fremdes `Girder.*` von nuget.org fern; jetzt haelt sie fest, dass
    genau EINE Quelle diese Namen beantworten darf. Ohne sie wuerde jede
    zusaetzlich eingerichtete Quelle — eine Firmenspiegelung, ein lokaler
    Ordner — bei jedem Namen mitgefragt, und wer zuerst antwortet, gewinnt.

    `<clear />` bleibt aus demselben Grund: es wirft die Quellen aus der
    Benutzerkonfiguration weg, die auf einem Entwicklerrechner sonst
    stillschweigend mitgelten.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Noelia.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

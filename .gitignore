htmlcov/

node_modules/
# Turbo's build cache. Turbo itself went with the pnpm workspace (no
# turbo.json, no root package.json) — the rule stays anyway: 531 files and
# 1.2 MB of .tar.zst lay tracked in the repository because there never was one.
# A cache never belongs in the repository, not even that of a tool we do not
# use right now.
.turbo/
# Playwright artefacts: traces and screenshots of a run, no sources.
test-results/
playwright-report/
# And the same images in the root directory: the rule above only applies
# inside test-results/, but a screenshot lands beside the sources when the path
# is missing at capture time. That is exactly how breit-1440.png, zahnrad.png
# and login-before.png came to lie in the repository.
/*.png

dist/
build/
*.egg-info/
# kon.txt and IMPLEMENTATION_PLAN.md now live in docs/vision/ so every clone can
# read the project vision. Kon2.txt stays out: it is a corrupted terminal
# transcript of one session, not a source document.
Kon2.txt
var/

# Browser debug output of the Playwright MCP (page snapshots, console logs).
# Produced while looking around in the browser, does not belong in the
# repository — 18 files had been tracked by accident.
.playwright-mcp/

# Screenshots for the before/after comparison in a PR. Images, no sources —
# and platform-dependent, so deliberately no reference images in the
# repository (font smoothing darwin vs. linux produces false alarms).
.screenshots/

# .NET
**/bin*
**/obj*
**/TestResults/

# The conversation transcript that served as a template for the move to
# Girder 4. Does not belong in the project.
kon.txt

# The signing key of the evidence (ADR-0044) and the generated documents.
# A private key in git would be no private key any more; the documents are a
# SNAPSHOT of a stack and belong where somebody needs them — not in the tree,
# where they are wrong the next day. `scripts/evidence.sh` writes the key to
# .evidence/ and the documents to evidence/.
#
# WITH A LEADING SLASH, and that was measured: without it the pattern applies
# in EVERY directory, and `git` compares on a file system that does not tell
# upper from lower case (macOS, core.ignorecase=true) without regard to case as
# well. `nachweis/` swallowed `src/*/…Infrastructure/Nachweis/` that way — two
# source files were missing from the commit, the tree went on building locally,
# and CI fell with "namespace 'Nachweis' does not exist". Once more a place where
# two sides spelled the same thing differently. The same holds for `evidence/`
# and every `…/Evidence/` folder today.
/.evidence/
/evidence/
# The same two places under their names before the English rename (25.09.2026).
# NOT an alias: a clone that ran `make nachweis` still holds its PRIVATE signing
# key in .nachweis/schluessel.pem, and without these lines that key would turn
# up as an untracked file one `git add -A` away from the repository. Move it
# (`mv .nachweis/schluessel.pem .evidence/key.pem`) and these lines can go.
/.nachweis/
/nachweis/

# The local control plane's state: history, signing key, operator journal,
# its own key ring. Machine-local, and the signing key never belongs in git.
.control-plane/
.monarch/local/

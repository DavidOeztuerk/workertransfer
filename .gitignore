node_modules/
# Turbos Bauzwischenspeicher. Turbo selbst ist mit dem pnpm-Workspace
# gegangen (keine turbo.json, keine Wurzel-package.json) — die Regel bleibt
# trotzdem: 531 Dateien und 1,2 MB .tar.zst lagen verfolgt im Repository,
# weil nie eine da war. Ein Zwischenspeicher gehoert nie ins Repository,
# auch nicht der eines Werkzeugs, das wir gerade nicht benutzen.
.turbo/
# Playwright-Artefakte: Traces und Screenshots eines Laufs, keine Quellen.
test-results/
playwright-report/
# Und dieselben Bilder im Wurzelverzeichnis: die Regel darueber greift nur
# innerhalb von test-results/, ein Screenshot landet aber neben den Quellen,
# wenn der Pfad beim Aufnehmen fehlt. Genau so lagen breit-1440.png,
# zahnrad.png und login-before.png im Repository.
/*.png

dist/
build/
*.egg-info/
# kon.txt and IMPLEMENTATION_PLAN.md now live in docs/vision/ so every clone can
# read the project vision. Kon2.txt stays out: it is a corrupted terminal
# transcript of one session, not a source document.
Kon2.txt
var/

# Browser-Debug-Ausgabe des Playwright-MCP (Seitenabzüge, Konsolenprotokolle).
# Erzeugt beim Nachsehen im Browser, gehört nicht ins Repository — 18 Dateien
# waren versehentlich verfolgt.
.playwright-mcp/

# Screenshot-Aufnahmen für den Vorher/Nachher-Vergleich im PR. Bilder, keine
# Quellen — und plattformabhängig, deshalb bewusst keine Referenzbilder im
# Repository (Schriftglättung darwin vs. linux erzeugt Fehlalarme).
.screenshots/


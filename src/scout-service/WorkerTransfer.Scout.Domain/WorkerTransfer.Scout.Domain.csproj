    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Noelia.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same vocabulary as in the profile and in the advert: whoever
         searches for "postgres" searches for "PostgreSQL". Two spellings would
         be two searches with two results (ADR-0023). -->

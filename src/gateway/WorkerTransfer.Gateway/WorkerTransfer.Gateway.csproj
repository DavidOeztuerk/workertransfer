<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ocelot" />
    <!--
      Noelia's middleware for the brake and the correlation id — and since
      4.2.0 it costs nothing more: `Noelia.Http` brings ZERO third-party
      packages, while `Noelia.Infrastructure` would pull forty-four. Exactly
      that price was the reason both stood here by hand before.
    -->
    <PackageReference Include="Noelia.Abstractions" />
    <PackageReference Include="Noelia.Http" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Only for `EnvironmentFile.Load()`. The gateway deliberately does NOT call
      `AddWorkerTransferDefaults` — it has no database, no CQRS pipeline and no
      endpoints that verify a token. But it should read its configuration
      exactly like the fourteen others: a second way of doing that would be a
      second place where a key can be missing.
    -->
    <ProjectReference Include="..\..\shared\WorkerTransfer.ServiceDefaults\WorkerTransfer.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The route map travels with the image. It is no appendix to the
      configuration but the only thing this service does.
    -->
    <Content Update="ocelot.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

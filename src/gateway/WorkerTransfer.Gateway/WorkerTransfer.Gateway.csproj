<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ocelot" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Die Landkarte reist mit dem Bild. Sie ist kein Anhängsel der
      Konfiguration, sondern das Einzige, was dieser Dienst tut.
    -->
    <Content Update="ocelot.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

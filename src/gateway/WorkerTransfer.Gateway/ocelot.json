// The system's route map, in ONE place.
//
// It is the whole service: the gateway routes and checks nothing. No token is
// read here, no consent checked, no role enforced - every service does that
// for itself, and a gateway that did it as well would be a second truth about
// the same question.
//
// What does NOT stand here matters just as much: `/erasure`, `/internal/notify`
// and `/companies/withdrawal`. All three are service-to-service entrances
// behind a shared secret. Making them reachable over the public origin would
// mean putting "delete everything about this person" on the net, guarded by a
// header. Without a route they reach none of the services that implement
// them.
//
// `/companies/withdrawal` DID stand here until D2, with priority 100. It was
// noticed only when every route was checked one by one against its expected
// answer: the endpoint answered publicly with 401 and so confirmed that it
// exists. The route was never needed — identity-service calls jobs-service
// directly (`Erasure__BaseUrls__jobs`), not through this gateway, and the
// interface does not know the path.
//
// Comments are allowed: .NET's JSON configuration provider skips them.
// Measured before this file was written this way - because a route map without
// reasons is the map from which somebody removes a rule because it looks
// strange.
{
  "Routes": [
    // --- 100/90: the exceptions --------------------------------------------
    //
    // The services' paths are NOT disjoint: `/companies/{id}/members`
    // belongs to identity, `/companies/{id}/profile` belongs to companies -
    // they differ only in the last segment. Prefix routing alone is therefore
    // not enough.
    //
    // WHAT `Priority` REALLY DOES HERE, measured: it makes the route map
    // INDEPENDENT OF ORDER. With these values reversing all lines changes
    // nothing; without them the file order decides, and eight routes fall
    // over. Setting all of them to the same value looked harmless at first -
    // the suite stayed green because the lines happened to stand in the right
    // order. Whoever appends a route down here should not have to rely on
    // that; `RouteOrderTests` pins it.
    {
      "UpstreamPathTemplate": "/jobs/{stelle}/applications",
      "DownstreamPathTemplate": "/jobs/{stelle}/applications",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "applications-service",
          "Port": 8007
        }
      ],
      "Priority": 100
    },
    {
      "UpstreamPathTemplate": "/companies/me/jobs",
      "DownstreamPathTemplate": "/companies/me/jobs",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "jobs-service",
          "Port": 8006
        }
      ],
      "Priority": 100
    },
    {
      "UpstreamPathTemplate": "/companies/me/application-stats",
      "DownstreamPathTemplate": "/companies/me/application-stats",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "applications-service",
          "Port": 8007
        }
      ],
      "Priority": 100
    },
    {
      "UpstreamPathTemplate": "/companies/me/profile",
      "DownstreamPathTemplate": "/companies/me/profile",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "companies-service",
          "Port": 8008
        }
      ],
      "Priority": 100
    },
    {
      "UpstreamPathTemplate": "/companies/by-slug/{kuerzel}",
      "DownstreamPathTemplate": "/companies/by-slug/{kuerzel}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "companies-service",
          "Port": 8008
        }
      ],
      "Priority": 100
    },
    // New compared with the Traefik map: `/me` belongs to identity, but
    // `/me/notification-preferences` belongs to notification-service. In
    // Python the notifications still lived in identity; since the move these
    // two paths are not disjoint any more either.
    {
      "UpstreamPathTemplate": "/me/notification-preferences",
      "DownstreamPathTemplate": "/me/notification-preferences",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "notification-service",
          "Port": 8010
        }
      ],
      "Priority": 100
    },
    {
      "UpstreamPathTemplate": "/companies/{firma}/profile",
      "DownstreamPathTemplate": "/companies/{firma}/profile",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "companies-service",
          "Port": 8008
        }
      ],
      "Priority": 90
    },

    // --- 10: the ordinary cases ---------------------------------------------
    //
    // Two lines per prefix, because Ocelot does not hit `/auth` and
    // `/auth/login` with one pattern: `{rest}` requires a segment. That is the
    // visible price compared with Traefik's `PathPrefix` - in return every
    // address that exists stands here, instead of a pattern that would also
    // hit addresses that do not exist.
    {
      "UpstreamPathTemplate": "/auth",
      "DownstreamPathTemplate": "/auth",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/auth/{rest}",
      "DownstreamPathTemplate": "/auth/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/me",
      "DownstreamPathTemplate": "/me",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/me/{rest}",
      "DownstreamPathTemplate": "/me/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/companies",
      "DownstreamPathTemplate": "/companies",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/companies/{rest}",
      "DownstreamPathTemplate": "/companies/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/invitations",
      "DownstreamPathTemplate": "/invitations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/invitations/{rest}",
      "DownstreamPathTemplate": "/invitations/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/account",
      "DownstreamPathTemplate": "/account",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/account/{rest}",
      "DownstreamPathTemplate": "/account/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/consent",
      "DownstreamPathTemplate": "/consent",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "consent-service",
          "Port": 8002
        }
      ],
      "Priority": 10
    },
    {

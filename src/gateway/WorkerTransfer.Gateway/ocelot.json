      "DownstreamPathTemplate": "/portfolios/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "portfolio-service",
          "Port": 8005
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/jobs",
      "DownstreamPathTemplate": "/jobs",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "jobs-service",
          "Port": 8006
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/jobs/{rest}",
      "DownstreamPathTemplate": "/jobs/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "jobs-service",
          "Port": 8006
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/applications",
      "DownstreamPathTemplate": "/applications",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "applications-service",
          "Port": 8007
        }
      ],
      "Priority": 10
    },
    {
      // Writing and revising stream tokens from the model. Otherwise Ocelot
      // aborts after 90 seconds (DownstreamRoute.DefaultTimeoutSeconds),
      // although the letter is already on its way. Three minutes: the model
      // may be slow, a hanging service may not hang for ever.
      "UpstreamPathTemplate": "/applications/{rest}",
      "DownstreamPathTemplate": "/applications/{rest}",
      "DownstreamScheme": "http",
      "Timeout": 180,
      "DownstreamHostAndPorts": [
        {
          "Host": "applications-service",
          "Port": 8007
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/market",
      "DownstreamPathTemplate": "/market",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "transfer-service",
          "Port": 8009
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/market/{rest}",
      "DownstreamPathTemplate": "/market/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "transfer-service",
          "Port": 8009
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/transfers",
      "DownstreamPathTemplate": "/transfers",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {

        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/invitations",
      "DownstreamPathTemplate": "/invitations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8001
        }
      ],
      "Priority": 10
    },
    {

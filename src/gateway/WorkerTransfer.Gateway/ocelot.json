          "Port": 8011
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/github/{rest}",
      "DownstreamPathTemplate": "/github/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {

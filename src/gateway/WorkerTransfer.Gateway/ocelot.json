  // --- The brake -----------------------------------------------------------
  //
  // It stands in THIS file and not in a second one: the braked paths are a
  // selection FROM the route map above, and two files about the same paths
  // drift apart at the first new endpoint. `BrakeTests` turns red whatever
  // stands here and has no route there.
  //
  // COUNTED PER ORIGIN, NEVER PER EMAIL ADDRESS. Whoever braked per address
  // would build exactly the enumeration channel /auth/register closes: a
  // braked answer would reveal that the address exists. And it would let a
  // stranger lock out anybody whose address they know.
  //
  // THE NUMBERS ARE GENEROUS, and that is on purpose. Behind one origin there
  // is often a whole office with one address. A brake that bites there would
  // itself be the outage. It is meant to make FAST guessing impossible — not
  // slow guessing, because it does not help against that anyway, and it is
  // not the only thing that has to.
  // The section is Noelia's own (`DistributedRateLimitingOptions`) — since
  // Girder 4.2.0 there is nothing left to build here ourselves.
  //
  // THE THREE DEFAULTS STAND AT 0, AND THAT IS THE WHOLE TRICK: a limit of 0
  // writes no counter, so exclusively the five paths below count. Without
  // that a default would brake over everything — the whole interface travels
  // through this gateway too, and every asset fetch would count along.
  //
  // `Subject: Origin` keeps the second promise: per origin, never per user.
  "DistributedRateLimiting": {
    "RequestsPerMinute": 0,
    "RequestsPerHour": 0,
    "RequestsPerDay": 0,
    "Subject": "Origin",
    "EnableEndpointSpecificLimiting": true,

    // Empty, not left out: otherwise loopback stands on it by default, and
    // then nothing brakes here locally — you just do not see it.
    "WhitelistedIps": [],
    "WhitelistedEndpoints": [],

    "EndpointSpecificLimits": {
      // The actual reason for all of this: password guessing.
      "/auth/login": { "RequestsPerMinute": 20 },

      // A registration costs nothing and can be tried any number of times.
      // Tighter, because accounts come into being here.
      "/auth/register": { "RequestsPerMinute": 5 },

      // Sends a MAIL. Without a brake this is an amplifier: a stranger has an
      // address that does not belong to them written to a hundred times.
      "/auth/resend-verification": { "RequestsPerMinute": 3 },

      // A confirmation link does get clicked twice now and then. Wide enough
      // that this never gets in the way, tight enough that tokens cannot be
      // tried through.
      "/auth/verify-email": { "RequestsPerMinute": 20 },

      // WIDE, on purpose: every open tab refreshes. Too tight, and a person
      // with six tabs keeps signing themselves out.
      "/auth/refresh": { "RequestsPerMinute": 60 }
    }
  },

  "GlobalConfiguration": {
    // Only for the addresses Ocelot builds itself. The listener stands in
    // ASPNETCORE_URLS and is set by the container.
    "BaseUrl": "http://localhost:8090"
  }
}

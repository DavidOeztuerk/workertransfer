    // The scout (ADR-0036). It replaced `/candidates`, and that route stood
    // here beside it until 11.09.2026 — until the interface had moved. Now it
    // is gone: two searches side by side would be two truths, and
    // `docs/routenkarte.yml` records that the old path really answers nothing
    // any more.
    //
    // ONLY `/scout/{rest}` and no bare `/scout`: no endpoint lies under that
    // path itself. A route there would be a line in the route map that
    // describes nothing — and the map is a test, not a checklist.
    {
      "UpstreamPathTemplate": "/scout/{rest}",
      "DownstreamPathTemplate": "/scout/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "scout-service",
          "Port": 8012
        }
      ],
      "Priority": 10
    },

    // The advisor (ADR-0037). The mandate is four values; the STAGE of a
    // conversation stands in the ledger and nowhere else — this service holds
    // no visibility, it grants it in the person's name.
    //
    // ONLY `/advisor/{rest}` and no bare `/advisor`: no endpoint lies under
    // that path itself. A route there would be a line in the route map that
    // describes nothing — and the map is a test, not a checklist.
    {
      "UpstreamPathTemplate": "/advisor/{rest}",
      "DownstreamPathTemplate": "/advisor/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "advisor-service",
          "Port": 8013
        }
      ],
      "Priority": 10
    },

    // The work sample (ADR-0042). The service with the greatest potential for
    // abuse, and therefore the one with the tightest promises: the effort in
    // hours stands up front, the evaluation belongs to the CASE and never
    // leaves it, and the person always reads it — even after a revocation.
    //
    // TWO ROUTES HERE, unlike scout and advisor: two endpoints lie under
    // `/assessments` itself (the company sets a task, the company reads its
    // list). Ocelot does not carry `{rest}` on into nothing, so the bare path
    // needs a line of its own — otherwise it answers 404, and Ocelot's empty
    // one at that, which looks like a dead service.
    {
      "UpstreamPathTemplate": "/assessments",
      "DownstreamPathTemplate": "/assessments",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "assessment-service",
          "Port": 8014
        }
      ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/assessments/{rest}",
      "DownstreamPathTemplate": "/assessments/{rest}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "assessment-service",
          "Port": 8014
        }

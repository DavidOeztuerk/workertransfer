<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nur fuer `Umgebung.Laden()`: eine .env-Datei in die Prozessumgebung. -->
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Noelia.Infrastructure" />
    <!--
      Nur fuer `Wanderung`: jeder der zehn Dienste besitzt ein eigenes Schema
      und wandert es selbst. Relational, nicht Npgsql — welche Datenbank es
      ist, entscheidet der Dienst.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkerTransfer.Contracts.Identity\WorkerTransfer.Contracts.Identity.csproj" />
    <!--
      Die Form, in der jeder Dienst ueber sich selbst Auskunft gibt (ADR-0044).
      Sie haengt an DIESER Datei, weil `AddWorkerTransferDefaults` der eine
      Aufruf ist, den jeder Dienst macht — und weil dieselbe Datei den Fehler
      dokumentiert, den das hier verhindert: "Wir listeten fuenf Module auf und
      bekamen fuenf — und merkten nicht, was dadurch fehlte."
    -->
    <ProjectReference Include="..\WorkerTransfer.Nachweis\WorkerTransfer.Nachweis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die Ortstabelle reist IM Bild mit. Sie ist der Grund, warum kein
         Geokodierdienst gerufen wird (ADR-0032), und ohne sie kennt die
         Umkreissuche keinen einzigen Ort. -->
    <EmbeddedResource Include="Postleitzahlen.txt" />
  </ItemGroup>

</Project>

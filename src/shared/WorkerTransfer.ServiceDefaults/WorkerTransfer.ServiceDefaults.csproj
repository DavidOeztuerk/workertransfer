<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only for `EnvironmentFile.Load()`: a .env file into the process environment. -->
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Noelia.Infrastructure" />
    <PackageReference Include="Noelia.Dashboard" />
    <PackageReference Include="Noelia.InMemory" />
    <PackageReference Include="Noelia.Redis" />
    <!--
      Only for `SchemaMigration`: every service owns a schema of its own and
      migrates it itself. Relational, not Npgsql — which database it is, the
      service decides.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkerTransfer.Contracts.Identity\WorkerTransfer.Contracts.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The place table travels IN the image. It is the reason no geocoding
         service is called (ADR-0032), and without it the radius search knows
         not a single place. -->
    <EmbeddedResource Include="PostalCodes.txt" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WorkerTransfer.Jobs.Application\WorkerTransfer.Jobs.Application.csproj" />
    <ProjectReference Include="..\WorkerTransfer.Jobs.Domain\WorkerTransfer.Jobs.Domain.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.ServiceDefaults\WorkerTransfer.ServiceDefaults.csproj" />
    <!--
      Die Vertraege stehen an der Grenze, und `wt.ki.keine-zahl` sieht sie sich
      an: eine Zahl ueber einen Menschen entstuende in der Domaene und ginge
      HIER hinaus (ADR-0022 §1). Beide Flaechen oder keine — eine halbe Absuche
      meldet gruen ueber der Haelfte, die sie nicht gelesen hat.
    -->
    <ProjectReference Include="..\WorkerTransfer.Jobs.Contracts\WorkerTransfer.Jobs.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Noelia.Data.EntityFrameworkCore" />
    <PackageReference Include="Noelia.Infrastructure" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WorkerTransfer.Profile.Application\WorkerTransfer.Profile.Application.csproj" />
    <ProjectReference Include="..\WorkerTransfer.Profile.Domain\WorkerTransfer.Profile.Domain.csproj" />
    <!--
      Die Vertraege stehen an der Grenze, und `wt.ki.keine-zahl` sieht sie
      sich an: eine Zahl ueber einen Menschen entstuende in der Domaene und
      ginge HIER hinaus (ADR-0022 §1). Beide Flaechen oder keine — eine
      halbe Absuche meldet gruen ueber der Haelfte, die sie nicht gelesen hat.
    -->
    <ProjectReference Include="..\WorkerTransfer.Profile.Contracts\WorkerTransfer.Profile.Contracts.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.Contracts.Consent\WorkerTransfer.Contracts.Consent.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.Contracts.Erasure\WorkerTransfer.Contracts.Erasure.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.ServiceDefaults\WorkerTransfer.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Noelia.Data.EntityFrameworkCore" />
    <PackageReference Include="Noelia.Infrastructure" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

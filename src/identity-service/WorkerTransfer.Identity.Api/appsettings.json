{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // How long a sign-in lasts (docs/VISION-FRAGEN.md, K). Noelia's defaults are
  // 14 days without use and 30 days at most — two weeks signed in for a
  // platform holding CVs and consents. Eight hours without use ends a working
  // day; seven days is the ceiling however often it is refreshed.
  "TokenSessions": {
    "RefreshTokenLifetime": "08:00:00",
    "AbsoluteSessionLifetime": "7.00:00:00"
  }
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkerTransfer.Resume.Application\WorkerTransfer.Resume.Application.csproj" />
    <ProjectReference Include="..\WorkerTransfer.Resume.Domain\WorkerTransfer.Resume.Domain.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.Ablage\WorkerTransfer.Ablage.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.Contracts.Consent\WorkerTransfer.Contracts.Consent.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.Outbox\WorkerTransfer.Outbox.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.ServiceDefaults\WorkerTransfer.ServiceDefaults.csproj" />
    <!--
      The contracts stand at the boundary, and `wt.ki.keine-zahl` looks at
      them: a number about a human being would come into being in the domain and
      go out HERE (ADR-0022 §1). Both surfaces or none — half a search reports
      green over the half it did not read.
    -->
    <ProjectReference Include="..\WorkerTransfer.Resume.Contracts\WorkerTransfer.Resume.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Noelia.Data.EntityFrameworkCore" />
    <PackageReference Include="Noelia.Infrastructure" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- The text recogniser. In the process, without third-party packages, without a network (ADR-0043). -->
    <PackageReference Include="PdfPig" />
  </ItemGroup>

</Project>

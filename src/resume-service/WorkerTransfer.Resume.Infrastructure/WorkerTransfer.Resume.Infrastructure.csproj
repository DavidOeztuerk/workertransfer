<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkerTransfer.Resume.Application\WorkerTransfer.Resume.Application.csproj" />
    <ProjectReference Include="..\WorkerTransfer.Resume.Domain\WorkerTransfer.Resume.Domain.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.Ablage\WorkerTransfer.Ablage.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.Contracts.Consent\WorkerTransfer.Contracts.Consent.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.Outbox\WorkerTransfer.Outbox.csproj" />
    <ProjectReference Include="..\..\shared\WorkerTransfer.ServiceDefaults\WorkerTransfer.ServiceDefaults.csproj" />
    <!--
      Die Vertraege stehen an der Grenze, und `wt.ki.keine-zahl` sieht sie sich
      an: eine Zahl ueber einen Menschen entstuende in der Domaene und ginge
      HIER hinaus (ADR-0022 §1). Beide Flaechen oder keine — eine halbe Absuche
      meldet gruen ueber der Haelfte, die sie nicht gelesen hat.
    -->
    <ProjectReference Include="..\WorkerTransfer.Resume.Contracts\WorkerTransfer.Resume.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Noelia.Data.EntityFrameworkCore" />
    <PackageReference Include="Noelia.Infrastructure" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Der Texterkenner. Im Prozess, ohne Fremdpakete, ohne Netz (ADR-0043). -->
    <PackageReference Include="PdfPig" />
  </ItemGroup>

</Project>

# Copy to `.env` and adjust. `.env` is gitignored — never commit real secrets
# (CONTRIBUTING.md, docs/product-scope.md).
#
# Settings are read by pydantic-settings with the WORKER_ prefix
# (worker_platform.configuration.PlatformSettings). A variable without that
# prefix is silently ignored, so `IDENTITY_JWT_SECRET=...` does nothing.

# local | development | test | staging | production
WORKER_ENVIRONMENT=local

# Per-service database URLs. Each service owns its own database (ADR-0004);
# docker-compose.yml provisions one per service on a single Postgres container
# and sets this variable per container, so you only need it here when running a
# service directly on the host. Inside compose the host is `postgres`, not
# 127.0.0.1.
WORKER_DATABASE_URL=postgresql+asyncpg://worker:worker@127.0.0.1:5432/identity

# HS256 signing secret. identity-service issues the tokens; consent-service (and
# every later service) only verifies them, so they must share this exact value
# until a gateway or asymmetric keys arrive (ADR-0007, ULTRAPLAN Phase 10).
# Use at least 32 bytes. Generate one with: openssl rand -base64 48
WORKER_JWT_SECRET=dev-only-secret-change-me-in-production-32bytes

# Browser origins allowed to send credentialed requests. Dev/test only — the
# platform refuses CORS in production (same-origin behind the gateway).
WORKER_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser-visible API base URL for apps/web. Never put a secret behind a VITE_
# prefix — Vite inlines those into the shipped bundle.
VITE_API_BASE_URL=http://localhost:8001

# ── Formulierungshilfe (ADR-0024) ────────────────────────────────────────────
#
# LEER heißt: die Funktion ist AUS. Kein fremder Dienst wird angerufen, und die
# Oberfläche sagt es. Das ist Absicht — eine Voreinstellung, die im Zweifel
# anruft, würde den Profiltext einer Person hinausschicken, weil jemand
# vergessen hat, etwas abzuschalten.
#
# ACHTUNG, zwei verschiedene Namen, und das ist kein Versehen:
#
#   ANTHROPIC_API_KEY         ← DAS hier setzt du (Host bzw. diese Datei).
#                               docker-compose.yml liest es per
#                               ${ANTHROPIC_API_KEY:-} und reicht es weiter als
#   WORKER_ANTHROPIC_API_KEY  ← das liest pydantic-settings IM Container.
#
# Läufst du einen Dienst direkt auf dem Host (uv run worker-profile), dann
# braucht er die WORKER_-Schreibweise — ohne Präfix wird sie ignoriert.
ANTHROPIC_API_KEY=

# Nur EIN Anbieter ist gebaut (ADR-0024): Anthropic. Es gibt keinen
# Provider-Schalter, und der Schlüssel entscheidet nicht, WELCHER Anbieter
# genommen wird, sondern nur, OB die Funktion an ist. Ein zweiter Anbieter
# kommt, wenn eine Umgebung ihn braucht — vier Provider-Klassen vorrätig zu
# halten war genau der Fehler, an dem worker-ai vorher unbaubar war.
#
# Das Modell lässt sich wechseln, der Anbieter nicht:
WORKER_DRAFTING_MODEL=claude-sonnet-5

# Wohin der Aufruf geht. Voreinstellung ist Anthropic direkt; ein Gateway oder
# ein Proxy, der dieselbe Messages-API spricht, lässt sich hier eintragen.
# Das ist KEIN Provider-Wechsel — ein Dienst, der anders antwortet, passt nicht.
WORKER_DRAFTING_BASE_URL=https://api.anthropic.com/v1/messages

# ── Bremse am Auth-Rand ──────────────────────────────────────────────────────
#
# Leer/ungesetzt heißt: aus in LOCAL und TEST, an in allen anderen Umgebungen.
# Aus in LOCAL, weil im Compose-Stack jede Anfrage von derselben
# Gateway-Adresse kommt — eine Bremse je Herkunft träfe dort die eigene
# Testreihe statt eines Angreifers. Zum Ansehen ausdrücklich einschaltbar:
# WORKER_AUTH_THROTTLE_ENABLED=true
#
# Nur setzen, wenn wirklich ein Proxy davorsteht: X-Forwarded-For ist frei
# wählbar, und ihm ungefragt zu glauben hieße, gar keine Bremse zu haben.
# WORKER_TRUST_FORWARDED_FOR=false

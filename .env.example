# WorkerTransfer — die Konfiguration, vollständig.
#
#   make env && make up
#
# `make env` schreibt eine .env aus dieser Vorlage und WÜRFELT die drei
# Geheimnisse frisch. Ohne .env bricht `make up` ab und sagt, welcher Schlüssel
# fehlt — das ist Absicht.
#
# DIE DREI GEHEIMNISSE STEHEN HIER LEER, und das ist der Punkt: ein
# eingebauter Vorgabewert ist ein Geheimnis, das in git liegt. Wer diese Datei
# von Hand kopiert, füllt sie selbst — der Befehl steht jeweils daneben.
#
# ---------------------------------------------------------------------------
# WER DAS HIER LIEST
#
#   docker compose  liest .env aus der Wurzel von selbst und setzt die
#                   ${...}-Stellen in docker-compose.yml ein.
#   ein Dienst      liest sie über `Umgebung.Laden()` (DotNetEnv), erste Zeile
#                   jeder Program.cs — für den Fall, dass jemand einen Dienst
#                   allein startet. Im Container kommt die Umgebung von
#                   Compose oder vom Helm-Chart, und die gewinnt: eine bereits
#                   gesetzte Variable wird nicht überschrieben.
#
# Die Rangfolge ist also: gesetzte Umgebung > .env > appsettings.json.
#
# Später füllt Infisical die Umgebung. Es füttert diese Datei, es ersetzt den
# Mechanismus nicht — am Code ändert sich dafür nichts.
#
# ---------------------------------------------------------------------------
# WAS HIER NICHT STEHT
#
# Verbindungszeichenfolgen, Dienstadressen und Häfen. Die kennt
# docker-compose.yml (im Cluster das Chart), weil sie zur Topologie gehören und
# nicht zur Umgebung eines Menschen. Hier stehen Geheimnisse und die wenigen
# Werte, die sich je Installation unterscheiden.


# ===========================================================================
# GEHEIMNISSE — drei, und jedes hat einen eigenen Grund
# ===========================================================================

# Womit Token unterschrieben und geprüft werden.
#
# identity-service unterschreibt, alle anderen prüfen nur — heute mit DEMSELBEN
# Wert (HS256, ein geteiltes Geheimnis). Deshalb muss er überall gleich sein.
#
# Mindestens 32 Byte:  openssl rand -base64 32
#
# In `staging` und `production` weist der Dienst einen bekannten Entwicklungswert
# ausdrücklich zurück — ein Geheimnis, das einmal in git stand, ist keins mehr.
WORKERTRANSFER_JWT_SECRET=

# Womit ein Dienst eine Benachrichtigung anstoßen darf.
#
# Gilt für `POST /notifications` und `POST /internal/notify`. Beide sind
# Dienst-zu-Dienst-Eingänge ohne Route im Gateway; wer den Kopf nicht mitbringt,
# bekommt 404 und nicht 401 — ein 401 bestätigte, dass es den Endpunkt gibt.
#
#   openssl rand -base64 32
WORKERTRANSFER_NOTIFY_SECRET=

# Womit die Löschkaskade an ihre acht Empfänger geht.
#
# AUSDRÜCKLICH EIN ANDERER als der der Benachrichtigung: „darf eine Mail
# anstoßen" und „darf alles über einen Menschen löschen" dürfen nicht dasselbe
# Papier sein (ADR-0027).
#
#   openssl rand -base64 32
WORKERTRANSFER_ERASURE_SECRET=

# Der Hauptschluessel, unter dem hinterlegte Geheimnisse liegen — heute genau
# eines: der KI-Schluessel, den eine Person selbst in den Einstellungen
# eintraegt. AES-GCM, ein Zufallsvektor je Geheimnis.
#
# ROLLEN HEISST VERLIEREN. Es gibt keine Schluesselversionierung: ein neuer
# Hauptschluessel macht jedes hinterlegte Geheimnis unlesbar. Die Oberflaeche
# zeigt dann „keiner hinterlegt", und die Person legt einen neuen an — das ist
# der ehrliche Zustand fuer den ersten Schritt, und er steht hier, damit ihn
# niemand aus Versehen ausloest.
#
#   openssl rand -base64 32
WORKERTRANSFER_SECRETS_KEY=


# ===========================================================================
# WAS SICH JE INSTALLATION UNTERSCHEIDET
# ===========================================================================

# Welche Ursprünge der Browser haben darf (CORS), kommagetrennt.
#
# Ohne diesen Schlüssel fällt Girder in Development auf `http://localhost:3000`
# zurück — einen Ursprung, den es hier nicht gibt. Die Oberfläche liegt auf
# 5173, durch das Gateway auf 8090.
WORKERTRANSFER_CORS_ORIGINS=http://localhost:5173,http://localhost:8090

# Unter welcher Adresse Menschen die Oberfläche erreichen.
#
# Steht in den Mails — Bestätigungslink, Einladung. Falsch gesetzt heißt: die
# Mail kommt an und der Link führt ins Leere.
WORKERTRANSFER_WEB_URL=http://localhost:8090

# Ein GitHub-Token für github-service.
#
# LEER LASSEN ist gültig und der Normalfall lokal: ohne Token fragt der Dienst
# unauthentifiziert an und läuft in GitHubs enges Ratenlimit. Er sagt das, statt
# so zu tun, als ginge es.
WORKERTRANSFER_GITHUB_TOKEN=

# Die Anmeldung über GitHub — sie ersetzt die Gist-Handarbeit.
#
# ALLE DREI LEER LASSEN ist gültig und der Normalfall lokal: dann bietet die
# Oberfläche nur den Gist an. Wer sie einrichten will, legt unter
# github.com/settings/developers eine OAuth-App an und trägt hier ein, was dort
# steht. Die Rückadresse muss dort WORTGLEICH hinterlegt sein — GitHub weist
# jede andere ab.
#
# Es wird kein Recht erbeten (`scope` bleibt leer): gebraucht wird ein einziger
# Aufruf, um den Anmeldenamen zu erfahren. Das Zugriffstoken wird danach
# weggeworfen und nirgends gespeichert.
WORKERTRANSFER_GITHUB_OAUTH_ID=
WORKERTRANSFER_GITHUB_OAUTH_SECRET=
WORKERTRANSFER_GITHUB_OAUTH_RUECKADRESSE=http://localhost:5173/github

# Der Schlüssel für die KI-Naht (`POST /profiles/me/draft`, `POST /jobs/draft`).
#
# LEER LASSEN ist gültig und die Vorgabe: ohne Schlüssel wird KEIN externer
# Dienst gerufen, und die Oberfläche sagt das. Nichts wird gespeichert — weder
# die Anfrage noch die Antwort (ADR-0024).
ANTHROPIC_API_KEY=


# ===========================================================================
# NUR LOKAL
# ===========================================================================

# Wie viel Luft die Auth-Bremse im lokalen Stapel hat.
#
# 1 ist die Vorgabe und der ausgelieferte Wert. Lokal steht 40, weil die
# Playwright-Reisen 34 Konten anlegen — alle von einer Herkunft, binnen weniger
# Minuten. Ein Prüfstand ist nicht die Bedrohung, gegen die die Bremse gebaut
# ist.
#
# NICHT ins Chart übernehmen: dort läuft kein Prüfstand, und ein Faktor in einer
# Staging-Umgebung wäre eine Bremse, die nur so aussieht.
WORKERTRANSFER_BREMSE_FAKTOR=40

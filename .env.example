# Copy to `.env` and adjust. `.env` is gitignored — never commit real secrets
# (CONTRIBUTING.md, docs/product-scope.md).
#
# Settings are read by pydantic-settings with the WORKER_ prefix
# (worker_platform.configuration.PlatformSettings). A variable without that
# prefix is silently ignored, so `IDENTITY_JWT_SECRET=...` does nothing.

# local | development | test | staging | production
WORKER_ENVIRONMENT=local

# Per-service database URLs. Each service owns its own database (ADR-0004);
# docker-compose.yml provisions both on one Postgres container.
# Set the one matching the service you are starting — the variable name is the
# same for every service, which is why run-dev.sh exports it per process.
WORKER_DATABASE_URL=postgresql+asyncpg://worker:worker@127.0.0.1:5432/identity

# HS256 signing secret. identity-service issues the tokens; consent-service (and
# every later service) only verifies them, so they must share this exact value
# until a gateway or asymmetric keys arrive (ADR-0007, ULTRAPLAN Phase 10).
# Use at least 32 bytes. Generate one with: openssl rand -base64 48
WORKER_JWT_SECRET=dev-only-secret-change-me-in-production-32bytes

# Browser origins allowed to send credentialed requests. Dev/test only — the
# platform refuses CORS in production (same-origin behind the gateway).
WORKER_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser-visible API base URL for apps/web. Never put a secret behind a VITE_
# prefix — Vite inlines those into the shipped bundle.
VITE_API_BASE_URL=http://localhost:8001

{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["VITE_API_BASE_URL", "VITE_CONSENT_BASE_URL", "VITE_PROFILE_BASE_URL", "VITE_RESUME_BASE_URL", "VITE_PORTFOLIO_BASE_URL", "VITE_JOBS_BASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Also pins what our dependencies drag in. A transitive package with a
      known vulnerability is then raised here rather than waited on.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <GirderVersion>3.0.1</GirderVersion>
  </PropertyGroup>

  <ItemGroup Label="Girder">
    <PackageVersion Include="Girder.Abstractions" Version="$(GirderVersion)" />
    <PackageVersion Include="Girder.Application" Version="$(GirderVersion)" />
    <PackageVersion Include="Girder.Contracts" Version="$(GirderVersion)" />
    <PackageVersion Include="Girder.Core" Version="$(GirderVersion)" />
    <PackageVersion Include="Girder.Data.EntityFrameworkCore" Version="$(GirderVersion)" />
    <PackageVersion Include="Girder.InMemory" Version="$(GirderVersion)" />
    <PackageVersion Include="Girder.Infrastructure" Version="$(GirderVersion)" />
    <PackageVersion Include="Girder.Passwords.BCrypt" Version="$(GirderVersion)" />
  </ItemGroup>

  <ItemGroup Label="Persistenz">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Gateway">
    <PackageVersion Include="Ocelot" Version="25.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <!--
      Angehoben, nicht referenziert: Testcontainers zieht SSH.NET 2024.1.0 mit
      GHSA-q939-rpr3-3284, behoben erst in 2026.0.0. Das transitive Pinning
      oben ist genau dafuer da.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Nur in Tests: sie stellen den Token aus, den die Dienste pruefen. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>

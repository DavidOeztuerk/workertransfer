# transfer-service — die Variablen, die dieser Dienst WIRKLICH liest.
#
# Erzeugt aus `TransferServiceSettings`. `tests/test_env_examples_are_real.py` hält die
# Datei dagegen: eine Variable, die hier steht und keine Entsprechung hat,
# macht den Test rot.
#
# Der Grund ist nicht Ordnungsliebe. pydantic-settings ist auf
# `extra="ignore"` gestellt und verwirft Unbekanntes STILLSCHWEIGEND — wer
# `WORKER_REDIS_URL` setzt, bekommt keine Fehlermeldung und glaubt, etwas
# eingestellt zu haben. Genau das stand hier vorher, fünfzehn Zeilen lang.
#
# Kopieren nach `.env` (gitignored). Niemals ein echtes Geheimnis committen.

WORKER_SERVICE_NAME=transfer-service
WORKER_SERVICE_VERSION=0.1.0
WORKER_ENVIRONMENT=local
WORKER_HOST=127.0.0.1
WORKER_PORT=8000
WORKER_ENABLE_DOCS=False
WORKER_ALLOW_DEVELOPMENT_TENANT_HEADER=False
WORKER_CORS_ALLOW_ORIGINS=
WORKER_CORS_ALLOW_CREDENTIALS=True
WORKER_CORS_ALLOW_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
WORKER_CORS_ALLOW_HEADERS=content-type,authorization
WORKER_CORS_EXPOSE_HEADERS=
WORKER_DATABASE_URL=postgresql+asyncpg://worker:worker@127.0.0.1:5432/transfer
WORKER_CONSENT_BASE_URL=http://127.0.0.1:8002
WORKER_IDENTITY_BASE_URL=http://127.0.0.1:8001
WORKER_NOTIFY_SECRET=
WORKER_JWT_SECRET=

# Wie oft der Outbox-Zusteller nachsieht (ADR-0025). Sekunden, nicht
# Millisekunden: eine Benachrichtigung ist keine Echtzeitsache, und ein
# enger Takt wäre nur Last auf der Datenbank.
WORKER_OUTBOX_INTERVAL_SECONDS=5.0

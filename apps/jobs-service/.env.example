# jobs-service — die Variablen, die dieser Dienst WIRKLICH liest.
#
# Erzeugt aus `JobsServiceSettings`. `tests/test_env_examples_are_real.py` hält die
# Datei dagegen: eine Variable, die hier steht und keine Entsprechung hat,
# macht den Test rot.
#
# Der Grund ist nicht Ordnungsliebe. pydantic-settings ist auf
# `extra="ignore"` gestellt und verwirft Unbekanntes STILLSCHWEIGEND — wer
# `WORKER_REDIS_URL` setzt, bekommt keine Fehlermeldung und glaubt, etwas
# eingestellt zu haben. Genau das stand hier vorher, fünfzehn Zeilen lang.
#
# Kopieren nach `.env` (gitignored). Niemals ein echtes Geheimnis committen.

WORKER_SERVICE_NAME=jobs-service
WORKER_SERVICE_VERSION=0.1.0
WORKER_ENVIRONMENT=local
WORKER_HOST=127.0.0.1
WORKER_PORT=8000
WORKER_ENABLE_DOCS=False
WORKER_ALLOW_DEVELOPMENT_TENANT_HEADER=False
WORKER_CORS_ALLOW_ORIGINS=
WORKER_CORS_ALLOW_CREDENTIALS=True
WORKER_CORS_ALLOW_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
WORKER_CORS_ALLOW_HEADERS=content-type,authorization
WORKER_CORS_EXPOSE_HEADERS=
WORKER_DATABASE_URL=postgresql+asyncpg://worker:worker@127.0.0.1:5432/jobs
WORKER_JWT_SECRET=

# Die Formulierungshilfe für die eigene Stellenanzeige (ADR-0024).
# Leer heißt AUS: ohne Schlüssel wird kein fremder Dienst angerufen, und die
# Oberfläche sagt es. Das ist die Voreinstellung, nicht ein Versehen.
WORKER_ANTHROPIC_API_KEY=
WORKER_DRAFTING_MODEL=claude-sonnet-5
# Nur für ein Gateway oder einen Proxy davor — KEIN Anbieterwechsel: was dort
# antwortet, muss die Messages-API sprechen.
WORKER_DRAFTING_BASE_URL=https://api.anthropic.com/v1/messages

# Wohin Traces gehen (OTLP/gRPC). LEER heißt AUS: ohne Endpunkt wird nicht
# instrumentiert und nichts gesendet — dieselbe Regel wie beim Entwurfsdienst.
# Im Compose-Stapel zeigt er auf http://jaeger:4317.
WORKER_OTLP_ENDPOINT=

# Gemeinsames Geheimnis für `POST /internal/company-withdrawal` (ADR-0027 §7).
# jobs-service ist KEIN Empfänger der Löschkaskade — er hält nichts
# Personenbezogenes. Er bekommt nur die Absicht, die Anzeigen eines
# stillgelegten Unternehmens zurückzuziehen.
#
# LEER heißt: der Endpunkt ist ZU.
WORKER_ERASURE_SECRET=

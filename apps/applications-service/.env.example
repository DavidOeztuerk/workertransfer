# applications-service Service Environment Variables

# Service
WORKER_SERVICE_NAME=applications-service
WORKER_SERVICE_VERSION=0.1.0
WORKER_ENVIRONMENT=local
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_ENABLE_DOCS=true
WORKER_ALLOW_DEVELOPMENT_TENANT_HEADER=true

# Database
WORKER_DATABASE_URL=postgresql://workertransfer:workertransfer@localhost:5432/applications_service
WORKER_DATABASE_POOL_SIZE=20
WORKER_DATABASE_MAX_OVERFLOW=10
WORKER_DATABASE_ECHO=false

# Redis
WORKER_REDIS_URL=redis://localhost:6379/0

# RabbitMQ
WORKER_RABBITMQ_URL=amqp://workertransfer:workertransfer@localhost:5672/

# Authentication
WORKER_JWT_SECRET=your-super-secret-jwt-key-change-in-production
WORKER_JWT_ALGORITHM=RS256
WORKER_ACCESS_TOKEN_EXPIRE_MINUTES=15
WORKER_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenTelemetry
WORKER_OTEL_ENDPOINT=http://jaeger:4317

# Feature Flags
WORKER_FEATURE_CQRS=true
WORKER_FEATURE_EVENTS=true
WORKER_FEATURE_MESSAGING=true
WORKER_FEATURE_CACHING=true
WORKER_FEATURE_RATE_LIMITING=true
WORKER_FEATURE_MULTITENANCY=true